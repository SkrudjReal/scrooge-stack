@@ -21,6 +22,20 @@ except ModuleNotFoundError:
 SKIP_DIRS = {".obsidian", ".trash", ".smart-env", ".archive", ".git"}
 
 
+def iter_vault_notes(vault_path: Path):
+    """Prune system directories before entering them; never follow symlinks."""
+    def fail(error):
+        raise error
+
+    for base, dirs, files in os.walk(vault_path, onerror=fail):
+        dirs[:] = [d for d in dirs if d not in SKIP_DIRS
+                   and not (Path(base) / d).is_symlink()]
+        for name in files:
+            path = Path(base) / name
+            if name.endswith(".md") and not path.is_symlink():
+                yield path
+
+
 def load_config() -> dict:
